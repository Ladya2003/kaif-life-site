---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import PhotoPair from '../components/PhotoPair.astro';
import { getSocials, getFeaturedStories, getEpisodes } from '../i18n/content';
import { translate, localizedPath, type Locale } from '../i18n';
interface Props {locale?:Locale;}
const {locale='ru'}=Astro.props;
const t=translate(locale);
const socials=getSocials(locale), stories=getFeaturedStories(locale), episodes=getEpisodes(locale);
---
<Layout locale={locale}>
<section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="live-dot"></span>{t('hero.eyebrow')}</p><h1>{t('hero.title')}<br/><span class="serif orange">{t('hero.titleAccent')}</span></h1><p class="hero-intro">{t('hero.intro')}</p><div class="hero-actions"><a class="button" href={localizedPath(locale,'/stories/')}>{t('hero.explore')} <span>↗</span></a><a class="text-link" href="https://youtu.be/FLn9T8HfdJA" target="_blank" rel="noopener noreferrer">▷ {t('hero.watch')}</a></div><p class="handnote hero-note">{t('hero.note1')}<br/>{t('hero.note2')}</p></div><div class="hero-photo"><span class="sticker">{t('hero.sticker1')}<br/><b>{t('hero.sticker2')}</b></span><PhotoPair locale={locale} first="9" second="8" alt={t('hero.photoAlt')} secondAlt={t('hero.secondAlt')} caption={t('hero.caption')} eager/><span class="photo-scribble" aria-hidden="true">↖ {t('hero.scribble')}</span></div><a class="scroll-note" href="#journal">{t('hero.scroll')} ↓</a></section>
<div class="ticker" aria-hidden="true"><div>{Array.from({ length: 12 }, () => t('ticker')).join(" ")}</div></div>
<section class="section wrap" id="journal"><div class="section-heading"><div><p class="eyebrow">{t('journal.eyebrow')}</p><h2>{t('journal.title')} <span class="serif">{t('journal.accent')}</span></h2></div><a class="text-link" href={localizedPath(locale,'/stories/')}>{t('journal.all')} ↗</a></div><div class="stories-grid">{stories.map((s,i)=><a class={`story-card story-${i}`} href={localizedPath(locale,`/stories/${s.slug}/`)}><div class="story-image"><Photo id={s.image} alt={s.alt}/><span class="story-number">0{i+1}</span><span class="round-arrow" aria-hidden="true">↗</span></div><div class="card-meta">{s.label}<span>{s.time} {t('journal.reading')}</span></div><h3>{s.title}</h3><p>{s.description}</p></a>)}</div></section>
<section class="section garage"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{t('garage.eyebrow')}</p><h2>{t('garage.title')}<br/><span class="serif">{t('garage.accent')}</span></h2></div><p class="section-aside">{t('garage.description')}</p></div><div class="episodes">{episodes.map(e=><a class="episode" href={`https://youtu.be/${e.id}`} target="_blank" rel="noopener noreferrer"><div class="episode-image">{e.image?<><Photo id={e.image} alt={e.alt}/><span class="play" aria-hidden="true">▷</span></>:<div class="dream-card"><span>{t('dream.label')}</span><strong>{t('dream.years')}</strong><em>{t('dream.note')}</em><span class="dream-arrow" aria-hidden="true">↗</span></div>}<span class="episode-tag">{e.tag}</span></div><h3>{e.title} ↗</h3><p>{e.caption}</p></a>)}</div><div class="garage-more"><a class="text-link" href="https://youtu.be/hFZJrFvkLsE" target="_blank" rel="noopener noreferrer">{t('garage.challenge')} ↗</a><a class="text-link" href="https://youtu.be/e3nY0EIAjaE" target="_blank" rel="noopener noreferrer">{t('garage.karting')} ↗</a></div></div></section>
<section class="section wrap moments"><div class="moment-text"><p class="eyebrow">{t('moments.eyebrow')}</p><h2>{t('moments.title')}<br/><span class="serif">{t('moments.accent')}</span></h2><p>{t('moments.body')}</p><p class="handnote">{t('moments.note')}</p></div><div class="moment-pair"><PhotoPair locale={locale} first="25" second="26" alt={t('moments.photoAlt')} secondAlt={t('moments.secondAlt')} caption={t('moments.caption')}/></div><div class="small-memory"><Photo id="20" alt={t('moments.sleepAlt')}/><p>{t('moments.sleep1')}<br/>{t('moments.sleep2')} 💤</p></div></section>
<section class="section about wrap" id="about"><div class="about-photo"><Photo id="3" alt={t('about.photoAlt')}/><p class="handnote">{t('about.note1')}<br/>{t('about.note2')}</p></div><div class="about-copy"><p class="eyebrow">{t('about.eyebrow')}</p><h2>{t('about.title1')}<br/>{t('about.title2')}<br/><span class="serif">{t('about.accent')}</span></h2><p>{t('about.body1')}</p><p>{t('about.body2')}</p><p>{t('about.body3')}</p><a class="text-link" href="https://www.linkedin.com/in/vladislav-vakulenchik-67a3a8279/" target="_blank" rel="noopener noreferrer">{t('about.linkedin')} ↗</a></div></section>
<section class="amorely-section" id="amorely"><div class="wrap amorely-grid"><div class="amorely-memory"><Photo id="19" alt={t('amorely.photoAlt')}/><span class="handnote">{t('amorely.note1')}<br/>{t('amorely.note2')} ♡</span></div><div><p class="eyebrow">{t('amorely.eyebrow')}</p><h2>{t('amorely.title1')}<br/>{t('amorely.title2')}<br/><span class="serif">{t('amorely.accent')}</span></h2><p>{t('amorely.body1')}</p><p>{t('amorely.body2')}</p><p>{t('amorely.body3')}</p><p class="amorely-last">{t('amorely.last')}</p><a class="button dark" href="https://amorely.love/" target="_blank" rel="noopener noreferrer">{t('amorely.visit')} <span>♡ ↗</span></a></div></div></section>
<section class="section wrap social-section"><div class="section-heading"><div><p class="eyebrow">{t('social.eyebrow')}</p><h2>{t('social.title')} <span class="serif">{t('social.accent')}</span></h2></div></div><div class="social-grid">{socials.map((s,i)=><a href={s.url} target="_blank" rel="noopener noreferrer"><span class="social-number">0{i+1}</span><h3>{s.name} <span>↗</span></h3><p>{s.note}</p></a>)}</div></section>
</Layout>
