---
import Icon from '../components/Icon.astro';
import Layout from './Layout.astro';
import Photo from '../components/Photo.astro';
import {getStories} from '../i18n/content';
import {translate,localizedPath,unlocalizedPath,type Locale} from '../i18n';
import previews from '../data/previews.json';
interface Props { title:string; description:string; image:string; alt:string; label:string; video:string; locale?:Locale; }
const {title,description,image,alt,label,video,locale='ru'}=Astro.props;
const t=translate(locale), stories=getStories(locale);
const slug=unlocalizedPath(Astro.url.pathname).split('/').filter(Boolean).at(-1) as keyof typeof previews;
const preview=previews[slug];
---
<Layout locale={locale} title={`${title} — KAIF LIFE`} description={description} image={preview.social} article articleSection={label} articleImages={[preview['16x9'],preview['4x3'],preview['1x1']]}>
<article><header class="article-header wrap"><nav class="breadcrumbs" aria-label={t('nav.label')}><a href={localizedPath(locale)}>{t('nav.home')}</a><span aria-hidden="true">/</span><a href={localizedPath(locale,'/stories/')}>{t('nav.stories')}</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav><p class="eyebrow">{label} / {t('article.experience')}</p><h1>{title}</h1><p class="lead">{description}</p></header><div class="article-cover wrap"><Photo id={image} alt={alt} eager/></div><div class="article-grid wrap"><aside class="article-sidebar"><span class="eyebrow">{t(slug.startsWith('car-challenge-')?'article.creatorSidebar':'article.sidebar')}</span><p>{t(slug.startsWith('car-challenge-')?'article.creatorNote':'article.note')}</p><a class="text-link" href={`https://youtu.be/${video}`} target="_blank" rel="noopener noreferrer">{t('article.watch')} <Icon name="arrow-up-right"/></a></aside><div class="prose"><slot/><div class="article-watch"><p class="eyebrow">{t('article.videoEyebrow')}</p><h2>{t('article.videoTitle')}</h2><p>{t('article.videoBody')}</p><a class="button" href={`https://youtu.be/${video}`} target="_blank" rel="noopener noreferrer">{t('article.open')} <Icon name="arrow-up-right"/></a></div></div></div></article><section class="wrap section"><div class="section-heading"><h2>{t('article.more')} <span class="serif">{t('article.moreAccent')}</span></h2></div><div class="related">{stories.filter(s=>s.slug!==slug).map(s=><a href={localizedPath(locale,`/stories/${s.slug}/`)}>{s.title}<span><Icon name="arrow-up-right"/></span></a>)}</div></section>
</Layout>
